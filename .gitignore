# Raw unflattened API responses (~46 MB). These are intermediate artifacts:
# nothing downstream reads them — the loader consumes the flattened CSVs
# next to them, which ARE committed. Regenerate by re-running the collector.
data-pipeline/seeds/raw/**/*_raw.json
data-pipeline/seeds/raw/weather/*.json

