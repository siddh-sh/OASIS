# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Use the SESSION POOLER string (port 5432, host contains "pooler"), not the
# "Direct connection" one: direct connections are IPv6-only on Supabase's
# free tier and fail from most home/college networks and from GitHub Actions.
#
# Replace [YOUR-PASSWORD] with the database password you set when creating
# the project. If the password contains @ : / or #, URL-encode it
# (@ -> %40, : -> %3A, / -> %2F, # -> %23).
DATABASE_URL=postgresql://postgres.abcdefghijklm:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Dashboard -> Project Settings -> API
SUPABASE_URL=https://abcdefghijklm.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...          # safe for the frontend (RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...  # BACKEND ONLY — bypasses row-level security

# Optional — only needed if this project still signs JWTs with a shared
# HS256 secret rather than the newer JWKS/ES256 default (backend tries JWKS
# first automatically; this is a fallback). Dashboard -> Project Settings ->
# API -> JWT Settings.
SUPABASE_JWT_SECRET=

# ---------------------------------------------------------------
# Anthropic (Week 3+, for the agent pipeline)
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
