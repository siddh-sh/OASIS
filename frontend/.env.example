# Copy to .env and fill in. .env is gitignored.

# The deployed/local FastAPI backend (backend/app/main.py).
VITE_API_BASE_URL=http://localhost:8000

# Only needed if a page ever talks to Supabase directly (e.g. Storage) —
# auth itself goes through the backend's /auth/* proxy endpoints, not
# straight to Supabase, so these are optional for now.
VITE_SUPABASE_URL=https://abcdefghijklm.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
